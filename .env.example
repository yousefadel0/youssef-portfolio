# Production URL (canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://youssefadel.dev

# Contact form email via Resend (https://resend.com). Leave empty to log briefs to the server console instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=yjou811@gmail.com
# Must be a sender on a domain you verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# Instant Telegram message for every brief (optional, works alongside or instead of email).
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after you message the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
